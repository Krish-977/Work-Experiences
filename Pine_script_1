// ============================================================= //
// EOD TRAILING DRAWDOWN — visuals                                //
// ============================================================= //
plot(dd_balance, title="DD: Balance (closed P&L)", color=color.new(color.blue, 40), linewidth=1)
plot(dd_trailingFloor, title="DD: Trailing Floor", color=color.red, style=plot.style_stepline, linewidth=2)
bgcolor(dd_breached ? color.new(color.red, 85) : na, title="DD Breach Zone")

var table dd_info = table.new(position.bottom_right, 2, 5, border_width = 1)
if barstate.islast
    table.cell(dd_info, 0, 0, "Balance", text_color = color.white, bgcolor = color.gray)
    table.cell(dd_info, 1, 0, str.tostring(dd_balance, "#,###"), text_color = color.white, bgcolor = color.gray)
    table.cell(dd_info, 0, 1, "Highest EOD", text_color = color.white, bgcolor = color.gray)
    table.cell(dd_info, 1, 1, str.tostring(dd_highestEOD, "#,###"), text_color = color.white, bgcolor = color.gray)
    table.cell(dd_info, 0, 2, "Trailing Floor", text_color = color.white, bgcolor = color.gray)
    table.cell(dd_info, 1, 2, str.tostring(dd_trailingFloor, "#,###"), text_color = color.white, bgcolor = color.gray)
    table.cell(dd_info, 0, 3, "Locked?", text_color = color.white, bgcolor = color.gray)
    table.cell(dd_info, 1, 3, dd_locked ? "Yes" : "No", text_color = color.white, bgcolor = color.gray)
    table.cell(dd_info, 0, 4, "Breached?", text_color = color.white, bgcolor = color.gray)
    table.cell(dd_info, 1, 4, dd_breached ? "YES" : "No", text_color = dd_breached ? color.red : color.white, bgcolor = color.gray)

alertcondition(dd_breached, title="EOD Trailing Drawdown Breach", message="Balance has fallen below the EOD trailing drawdown floor — account would be terminated")
